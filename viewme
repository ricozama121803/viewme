JS = r"""
(function(){
  var root=document.documentElement,body=document.body;
  function qs(s){return document.querySelector(s)}
  function api(p){return fetch(p,{credentials:'same-origin'}).then(function(r){return r.json()})}
  function setTheme(t){root.setAttribute('data-theme',t);api('/api/theme?set='+t).catch(function(){})}
  function effective(){var t=root.getAttribute('data-theme');if(t==='light'||t==='dark')return t;
    return matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}
  function toggleTheme(){setTheme(effective()==='dark'?'light':'dark')}
  function toggleToc(){body.classList.toggle('no-toc');qs('#b-toc').setAttribute('aria-pressed',!body.classList.contains('no-toc'))}
  function toggleSrc(){body.classList.toggle('show-src');qs('#b-src').setAttribute('aria-pressed',body.classList.contains('show-src'))}
  qs('#b-theme').onclick=toggleTheme;qs('#b-toc').onclick=toggleToc;qs('#b-src').onclick=toggleSrc;
  qs('#b-print').onclick=function(){window.print()};
  document.addEventListener('keydown',function(e){
    if(e.ctrlKey||e.metaKey||e.altKey||/input|textarea/i.test(e.target.tagName))return;
    if(e.key==='t')toggleTheme();else if(e.key==='o')toggleToc();else if(e.key==='s')toggleSrc();
  });
  if(!document.querySelector('nav.toc a'))body.classList.add('no-toc');
  document.querySelectorAll('.copy').forEach(function(b){b.onclick=function(){
    var text=b.closest('.code').querySelector('code').innerText;
    function done(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1200)}
    if(navigator.clipboard){navigator.clipboard.writeText(text).then(done,done)}else{
      var t=document.createElement('textarea');t.value=text;document.body.appendChild(t);t.select();
      try{document.execCommand('copy')}catch(e){}t.remove();done()}}});
  var links=[].slice.call(document.querySelectorAll('nav.toc a'));
  var heads=links.map(function(a){return document.getElementById(a.getAttribute('href').slice(1))});
  function spy(){var cur=0;for(var i=0;i<heads.length;i++){if(heads[i]&&heads[i].getBoundingClientRect().top<120)cur=i}
    links.forEach(function(a,i){a.classList.toggle('on',i===cur)})}
  if(links.length){addEventListener('scroll',spy,{passive:true});spy()}
  var last=null;
  function poll(){api('/api/stat?f='+encodeURIComponent(DOC)).then(function(d){
    if(last!==null&&d.m!==last)location.reload();last=d.m}).catch(function(){})}
  poll();setInterval(poll,1000);
})();
"""


def build_page(title, body, headings, doc_rel, raw_text, nonce, theme, source_label):
    toc = "".join('<a class="l%d" href="#%s">%s</a>' % (lvl, slug, html.escape(txt))
                  for lvl, slug, txt in headings if lvl <= 4)
    words = len(re.sub(r"<[^>]+>", " ", body).split())
    minutes = max(1, round(words / 220.0))
    theme_attr = theme if theme in ("light", "dark") else "auto"
    return """<!doctype html>
<html lang="en" data-theme="%(theme)s">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src 'self' https: http: data:; style-src 'unsafe-inline'; script-src 'nonce-%(nonce)s'; connect-src 'self'">
<title>%(title)s - viewme</title>
<style>%(css)s</style>
</head>
<body>
<header class="top">
  <span class="name">%(title)s</span><span class="meta">%(source)s &middot; %(words)d words &middot; %(minutes)d min read</span>
  <span class="sp"></span>
  <button class="btn" id="b-toc" type="button" aria-pressed="true" title="Toggle outline (o)">Outline</button>
  <button class="btn" id="b-src" type="button" aria-pressed="false" title="Toggle source (s)">Source</button>
  <button class="btn" id="b-print" type="button" title="Print">Print</button>
  <button class="btn" id="b-theme" type="button" title="Toggle theme (t)">Theme</button>
</header>
<div class="layout">
  <nav class="toc"><h4>On this page</h4>%(toc)s</nav>
  <main>
    <article>%(body)s</article>
    <pre id="src">%(raw)s</pre>
  </main>
</div>
<script nonce="%(nonce)s">var DOC=%(doc)s;%(js)s</script>
</body>
</html>
""" % {"theme": theme_attr, "nonce": nonce, "title": html.escape(title), "css": CSS, "source": html.escape(source_label),
       "words": words, "minutes": minutes, "toc": toc, "body": body, "raw": html.escape(raw_text),
       "doc": json.dumps(doc_rel).replace("</", "<\\/"), "js": JS}


# --------------------------------------------------------------------------
# Local server
# --------------------------------------------------------------------------

def config_path():
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "viewme" / "config.json"


def load_theme():
    try:
        return json.loads(config_path().read_text()).get("theme", "auto")
    except (OSError, ValueError):
        return "auto"


def save_theme(theme):
    try:
        p = config_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(json.dumps({"theme": theme}))
    except OSError:
        pass


def find_root(path):
    """Project root (nearest folder with .git) so relative images like ../img.png work."""
    home = Path.home()
    for parent in [path.parent] + list(path.parent.parents)[:6]:
        if (parent / ".git").exists():
            return parent
        if parent == home:
            break
    return path.parent


class App:
    def __init__(self, root, main, stdin_text, theme):
        self.root = root.resolve()
        self.main = main
        self.stdin_text = stdin_text
        self.token = secrets.token_urlsafe(24)
        self.theme = theme
        self.last_ping = time.time()
        self.seen_ping = False
        self.port = 0
        self.hosts = set()

    def rel_of(self, path):
        return path.resolve().relative_to(self.root).as_posix()

    def resolve(self, rel):
        try:
            p = (self.root / urllib.parse.unquote(rel)).resolve()
            p.relative_to(self.root)
        except (ValueError, OSError):
            return None
        return p if p.is_file() else None

    def render_doc(self, rel):
        if rel is None:
            text, title_fallback, source = self.stdin_text, "stdin", "stdin"
            cur_dir = "."
        else:
            p = self.resolve(rel)
            if p is None or not p.name.lower().endswith(DOC_SUFFIXES):
                return None
            text = p.read_text(encoding="utf-8", errors="replace")
            title_fallback, source = p.name, str(p.parent if p.parent != self.root else self.root).replace(str(Path.home()), "~")
            cur_dir = posixpath.dirname(rel) or "."
        r = Renderer()
        body = r.render(text, cur_dir)
        title = next((t for lvl, _, t in r.headings if lvl == 1), title_fallback)
        shown = title_fallback if title != title_fallback else title_fallback
        return build_page(title if title != title_fallback else shown, body, r.headings, rel or "", text,
                          secrets.token_urlsafe(16), self.theme, source + "/" + title_fallback if rel else source)


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "viewme"

    def log_message(self, *args):
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8", headers=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Cache-Control", "no-store")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        app = self.server.app
        if self.headers.get("Host", "") not in app.hosts:
            return self.send(403, "forbidden", "text/plain")
        url = urllib.parse.urlsplit(self.path)
        query = urllib.parse.parse_qs(url.query)
        if url.path == "/" and secrets.compare_digest(query.get("k", [""])[0], app.token):
            self.send_response(302)
            self.send_header("Set-Cookie", "viewme=%s; Path=/; HttpOnly; SameSite=Strict" % app.token)
            self.send_header("Location", "/")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        cookies = [c.strip() for c in self.headers.get("Cookie", "").split(";")]
        if not any(secrets.compare_digest(c, "viewme=" + app.token) for c in cookies):
            return self.send(403, "forbidden", "text/plain")

        path = url.path
        if path == "/":
            page = app.render_doc(app.rel_of(app.main) if app.main else None)
            return self.send(200, page)
        if path.startswith("/doc/"):
            page = app.render_doc(path[5:])
            return self.send(200, page) if page else self.send(404, "not found", "text/plain")
        if path.startswith("/raw/"):
            p = app.resolve(path[5:])
            if not p:
                return self.send(404, "not found", "text/plain")
            ctype = mimetypes.guess_type(str(p))[0] or "application/octet-stream"
            if ctype in ("text/html", "application/xhtml+xml"):
                ctype = "text/plain"
            return self.send(200, p.read_bytes(), ctype,
                             {"Content-Security-Policy": "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"})
        if path == "/api/stat":
            app.last_ping, app.seen_ping = time.time(), True
            rel = query.get("f", [""])[0]
            p = app.resolve(rel) if rel else app.main
            mtime = p.stat().st_mtime_ns if p and p.exists() else 0
            return self.send(200, json.dumps({"m": mtime}), "application/json")
        if path == "/api/theme":
            theme = query.get("set", [""])[0]
            if theme in ("light", "dark", "auto"):
                app.theme = theme
                save_theme(theme)
            return self.send(200, "{}", "application/json")
        return self.send(404, "not found", "text/plain")


# --------------------------------------------------------------------------
# Window launching
# --------------------------------------------------------------------------

CHROMIUM_NAMES = ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "brave-browser",
                  "microsoft-edge", "microsoft-edge-stable", "vivaldi"]


def find_chromium():
    override = os.environ.get("VIEWME_BROWSER")
    if override:
        return shutil.which(override) or override
    for name in CHROMIUM_NAMES:
        found = shutil.which(name)
        if found:
            return found
    return None


def serve(app, bind_host="127.0.0.1"):
    server = http.server.ThreadingHTTPServer((bind_host, 0), Handler)
    server.app = app
    app.port = server.server_address[1]
    app.hosts = {"127.0.0.1:%d" % app.port, "localhost:%d" % app.port}
    return server


def start(server):
    """Start serving. Must run after any fork(): threads do not survive one."""
    threading.Thread(target=server.serve_forever, daemon=True).start()


def main(argv=None):
    ap = argparse.ArgumentParser(prog="viewme", description="Open a Markdown file in a clean popup window.",
                                 epilog="Keys in the window: t theme, o outline, s source.")
    ap.add_argument("file", nargs="?", help='Markdown file to view, or "-" to read from stdin')
    ap.add_argument("--theme", choices=("light", "dark", "auto"), help="color theme (remembered)")
    ap.add_argument("--size", default="1000x820", metavar="WxH", help="window size (default 1000x820)")
    ap.add_argument("--fg", action="store_true", help="stay in the foreground until the window closes")
    ap.add_argument("--serve", action="store_true", help="only serve and print the URL, do not open a window")
    ap.add_argument("-V", "--version", action="version", version="viewme " + VERSION)
    args = ap.parse_args(argv)

    if not args.file:
        ap.print_usage(sys.stderr)
        print("viewme: missing FILE (try: viewme README.md)", file=sys.stderr)
        return 2

    stdin_text, main_path = None, None
    if args.file == "-":
        if sys.stdin.isatty():
            print("viewme: nothing piped to stdin", file=sys.stderr)
            return 2
        stdin_text = sys.stdin.read()
        root = Path.cwd()
    else:
        main_path = Path(args.file).expanduser()
        if not main_path.exists():
            print("viewme: no such file: %s" % args.file, file=sys.stderr)
            return 1
        if not main_path.is_file():
            print("viewme: not a file: %s" % args.file, file=sys.stderr)
            return 1
        main_path = main_path.resolve()
        root = find_root(main_path)

    if args.theme:
        save_theme(args.theme)
    app = App(root, main_path, stdin_text, args.theme or load_theme())
    m = re.match(r"^(\d{3,5})[xX](\d{3,5})$", args.size)
    width, height = (m.group(1), m.group(2)) if m else ("1000", "820")

    browser = None
    if not args.serve:
        if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY") or sys.platform == "darwin"):
            print("viewme: no display found. Use --serve to get a URL instead.", file=sys.stderr)
            return 1
        browser = find_chromium()
        if not browser and sys.platform == "darwin":
            mac = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
            browser = mac if os.path.exists(mac) else None

    server = serve(app)
    url = "http://127.0.0.1:%d/?k=%s" % (app.port, app.token)

    if args.serve:
        start(server)
        print("viewme serving %s\n  %s\n(Ctrl-C to stop)" % (args.file, url), flush=True)
        try:
            while True:
                time.sleep(3600)
        except KeyboardInterrupt:
            return 0

    if not args.fg:
        if os.fork() > 0:
            server.server_close()   # the child keeps its own copy of the socket
            return 0
        os.setsid()
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)

    start(server)
    if browser:
        profile = tempfile.mkdtemp(prefix="viewme-")
        cmd = [browser, "--app=" + url, "--user-data-dir=" + profile, "--no-first-run",
               "--no-default-browser-check", "--window-size=%s,%s" % (width, height),
               "--ozone-platform-hint=auto", "--class=viewme"]
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).wait()
        finally:
            shutil.rmtree(profile, ignore_errors=True)
    else:
        webbrowser.open(url)
        deadline = time.time() + 120
        while time.time() < deadline or (app.seen_ping and time.time() - app.last_ping < 180):
            if app.seen_ping:
                deadline = 0
            time.sleep(2)
    server.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
