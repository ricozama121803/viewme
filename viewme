# --------------------------------------------------------------------------
# Syntax highlighting (small and dependency free)
# --------------------------------------------------------------------------

HASH_LANGS = {"py", "python", "sh", "bash", "shell", "zsh", "console", "yaml", "yml", "toml", "ruby", "rb",
              "make", "makefile", "dockerfile", "r", "perl", "ini", "conf", "nginx"}
SLASH_LANGS = {"js", "javascript", "jsx", "ts", "typescript", "tsx", "c", "h", "cpp", "c++", "cc", "hpp", "java",
               "go", "rust", "rs", "css", "scss", "swift", "kotlin", "kt", "cs", "csharp", "php", "dart", "scala",
               "json", "jsonc", "glsl"}
DASH_LANGS = {"sql", "lua", "haskell", "hs"}
KEYWORDS = set("""
if else elif elsif unless for foreach while do until switch case default break continue return yield pass
def fn func function lambda class struct enum interface trait impl type typedef namespace module package
import from export include require use using as with in is not and or new delete try catch except finally
throw raise async await let const var static public private protected final abstract extends implements
void int long short char float double bool boolean string true false null nil none None True False self this
then fi esac done echo select from where join group order by insert update create table into values limit
""".split())


@functools.lru_cache(maxsize=8)
def _highlight_regex(comment):
    return re.compile(
        r"(?P<c>%s)"
        r"|(?P<s>\"(?:\\.|[^\"\\\n])*\"|'(?:\\.|[^'\\\n])*'|`(?:\\.|[^`\\])*`)"
        r"|(?P<n>\b0x[0-9a-fA-F]+\b|\b\d[\d_]*(?:\.\d+)?(?:[eE][+-]?\d+)?\b)"
        r"|(?P<k>\b[A-Za-z_][A-Za-z0-9_]*\b)" % comment, re.S)


def highlight(code, lang):
    lang = lang.lower()
    if lang in HASH_LANGS:
        comment = r"#[^\n]*"
    elif lang in SLASH_LANGS:
        comment = r"//[^\n]*|/\*.*?\*/"
    elif lang in DASH_LANGS:
        comment = r"--[^\n]*"
    else:
        return html.escape(code)
    out, pos = [], 0
    for m in _highlight_regex(comment).finditer(code):
        out.append(html.escape(code[pos:m.start()]))
        kind = m.lastgroup
        text = html.escape(m.group(0))
        if kind == "k" and m.group(0).lower() not in KEYWORDS:
            out.append(text)
        else:
            out.append('<span class="t-%s">%s</span>' % (kind, text))
        pos = m.end()
    out.append(html.escape(code[pos:]))
    return "".join(out)


# --------------------------------------------------------------------------
# Markdown renderer
# --------------------------------------------------------------------------

BLOCK_TAGS = {"address", "article", "aside", "blockquote", "center", "details", "div", "dl", "dt", "dd", "figcaption",
              "figure", "footer", "h1", "h2", "h3", "h4", "h5", "h6", "header", "hr", "li", "main", "nav", "ol", "p",
              "section", "summary", "table", "tbody", "td", "tfoot", "th", "thead", "tr", "ul"}
INLINE_TAGS = {"a", "abbr", "b", "br", "code", "del", "em", "i", "img", "kbd", "s", "small", "span", "strong",
               "sub", "sup", "u", "mark"}
ALLOWED_TAGS = BLOCK_TAGS | INLINE_TAGS
ALLOWED_ATTRS = {
    "a": {"href", "title"},
    "img": {"src", "alt", "title", "width", "height", "align"},
    "td": {"align", "colspan", "rowspan"},
    "th": {"align", "colspan", "rowspan"},
    "details": {"open"},
    "div": {"align"},
    "p": {"align"},
    "h1": {"align"}, "h2": {"align"}, "h3": {"align"},
}
LIST_RE = re.compile(r"^( {0,3})([*+-]|\d{1,9}[.)])( +|$)")
FENCE_RE = re.compile(r"^( {0,3})(`{3,}|~{3,})\s*([^\s`]*)[^`]*$")
HEADING_RE = re.compile(r"^ {0,3}(#{1,6})(?:\s+(.*?))?(?:\s+#+)?\s*$")
HR_RE = re.compile(r"^ {0,3}([-*_])(?: *\1){2,} *$")
TABLE_DELIM_RE = re.compile(r"^ {0,3}\|?\s*:?-+:?\s*(?:\|\s*:?-+:?\s*)*\|?\s*$")
ALERTS = {"NOTE": "Note", "TIP": "Tip", "IMPORTANT": "Important", "WARNING": "Warning", "CAUTION": "Caution"}


def slugify(text):
    s = html.unescape(re.sub(r"<[^>]+>", "", text)).strip().lower()
    s = re.sub(r"[^\w\- ]", "", s).replace(" ", "-")
    return s or "section"


def indent_of(line):
    return len(line) - len(line.lstrip(" "))


def split_row(line):
    line = line.strip()
    if line.startswith("|"):
        line = line[1:]
    if line.endswith("|") and not line.endswith("\\|"):
        line = line[:-1]
    return [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", line)]


class Renderer:
    """Renders Markdown to sanitized HTML. Raw HTML is limited to a safe allowlist."""

    def __init__(self):
        self.headings = []
        self.slugs = {}
        self.refs = {}
        self.cur_dir = "."

    # ---- urls ----------------------------------------------------------

    def make_url(self, url, image=False):
        """Return a safe URL, rewriting relative paths to the local server, or None."""
        url = html.unescape(url.strip())
        if not url:
            return None
        low = url.lower()
        if url.startswith("#") or low.startswith(("http://", "https://")):
            return url
        if low.startswith("mailto:"):
            return None if image else url
        if low.startswith("data:image/") and not low.startswith("data:image/svg"):
            return url
        if re.match(r"^[a-z][a-z0-9+.\-]*:", low) or url.startswith("//"):
            return None
        path, _, frag = url.partition("#")
        path = urllib.parse.unquote(path.split("?")[0])
        if not path:
            return None
        joined = posixpath.normpath(posixpath.join(self.cur_dir, path))
        if joined.startswith("..") or joined.startswith("/"):
            return None
        quoted = urllib.parse.quote(joined)
        if not image and joined.lower().endswith(DOC_SUFFIXES):
            return "/doc/" + quoted + ("#" + frag if frag else "")
        return "/raw/" + quoted

    def anchor(self, href, inner, title=None):
        safe = self.make_url(href)
        if safe is None:
            return inner
        attrs = ' href="%s"' % html.escape(safe, quote=True)
        if title:
            attrs += ' title="%s"' % html.escape(title, quote=True)
        if safe.lower().startswith(("http://", "https://")):
            attrs += ' target="_blank" rel="noopener noreferrer"'
        return "<a%s>%s</a>" % (attrs, inner)

    # ---- raw html ------------------------------------------------------

    def sanitize_tag(self, tag):
        if tag.startswith("<!--"):
            return ""
        m = re.match(r"<\s*(/?)\s*([A-Za-z][A-Za-z0-9]*)(.*?)(/?)\s*>$", tag, re.S)
        if not m or m.group(2).lower() not in ALLOWED_TAGS:
            return html.escape(tag, quote=False)
        closing, name, rest = m.group(1), m.group(2).lower(), m.group(3)
        if closing:
            return "</%s>" % name
        allowed = ALLOWED_ATTRS.get(name, set())
        attrs = ""
        for am in re.finditer(r"([a-zA-Z_:][-\w:.]*)(?:\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s\"'>]+)))?", rest):
            key = am.group(1).lower()
            val = next((g for g in am.groups()[1:] if g is not None), "")
            if key not in allowed:
                continue
            if key in ("href", "src"):
                val = self.make_url(val, image=(name == "img"))
                if val is None:
                    continue
            if key == "open":
                attrs += " open"
            else:
                attrs += ' %s="%s"' % (key, html.escape(html.unescape(val), quote=True))
        if name == "a" and 'href="http' in attrs:
            attrs += ' target="_blank" rel="noopener noreferrer"'
        return "<%s%s>" % (name, attrs)

    def raw_html(self, text):
        parts = re.split(r"(<!--.*?-->|</?[A-Za-z][^<>]*>)", text, flags=re.S)
        out = []
        for i, part in enumerate(parts):
            if i % 2:
                out.append(self.sanitize_tag(part))
            else:
                out.append(re.sub(r"&(?!#?\w+;)", "&amp;", part).replace("<", "&lt;"))
        return "".join(out)

    # ---- inline --------------------------------------------------------

    def inline(self, text):
        stash = []

        def put(s):
            stash.append(s)
            return "\x00%d\x00" % (len(stash) - 1)

        text = text.replace("\x00", "")
        text = re.sub(r"(?: {2,}|\\)\n", lambda m: put("<br>") + "\n", text)
        text = re.sub(r"\\([\\`*_{}\[\]()#+\-.!|<>~])", lambda m: put(html.escape(m.group(1))), text)
        text = re.sub(r"(`+)(?!`)(.+?)(?<!`)\1(?!`)",
                      lambda m: put("<code>%s</code>" % html.escape(m.group(2).strip())), text, flags=re.S)
        text = re.sub(r"<((?:https?://|mailto:)[^\s<>]+)>",
                      lambda m: put(self.anchor(m.group(1), html.escape(m.group(1), quote=False))), text)
        text = re.sub(r"<!--.*?-->|</?[A-Za-z][^<>]*>", lambda m: put(self.sanitize_tag(m.group(0))), text, flags=re.S)
        text = html.escape(text, quote=False)

        def image(m):
            src = self.make_url(m.group(2), image=True)
            if src is None:
                return put(html.escape(m.group(1)))
            title = ' title="%s"' % html.escape(html.unescape(m.group(3)), quote=True) if m.group(3) else ""
            return put('<img src="%s" alt="%s"%s>' % (html.escape(src, quote=True),
                                                       html.escape(html.unescape(m.group(1)), quote=True), title))

        text = re.sub(r"!\[([^\]]*)\]\(\s*<?([^)\s>]+)>?(?:\s+&quot;([^\"]*)&quot;|\s+\"([^\"]*)\")?\s*\)",
                      lambda m: image(m), text)

        def link(m):
            title = m.group(3) or m.group(4)
            return put(self.anchor(m.group(2), self.format(m.group(1)), html.unescape(title) if title else None))

        text = re.sub(r"\[((?:[^\[\]]|\[[^\]]*\])*)\]\(\s*<?([^)\s>]*)>?(?:\s+&quot;([^\"]*)&quot;|\s+\"([^\"]*)\")?\s*\)",
                      link, text)

        def ref_link(m):
            label = (m.group(2) or m.group(1)).strip().lower()
            if label not in self.refs:
                return m.group(0)
            href, title = self.refs[label]
            return put(self.anchor(href, self.format(m.group(1)), title))

        text = re.sub(r"\[([^\[\]]+)\]\[([^\[\]]*)\]", ref_link, text)
        text = re.sub(r"\[([^\[\]]+)\](?![(\[:])", lambda m: ref_link(m) if m.group(1).strip().lower() in self.refs
                      else m.group(0), text)
        text = self.format(text)
        text = re.sub(r"(?<![\w\"'=>/\x00])(https?://[^\s<>\x00]+[^\s<>\x00.,;:!?)\]'\"])",
                      lambda m: put(self.anchor(m.group(1), m.group(1))), text)
        while "\x00" in text:
            text = re.sub(r"\x00(\d+)\x00", lambda m: stash[int(m.group(1))], text)
        return text

    @staticmethod
    def format(text):
        text = re.sub(r"\*\*\*(?=\S)(.+?)(?<=\S)\*\*\*", r"<strong><em>\1</em></strong>", text)
        text = re.sub(r"\*\*(?=\S)(.+?)(?<=\S)\*\*", r"<strong>\1</strong>", text)
        text = re.sub(r"(?<!\w)__(?=\S)(.+?)(?<=\S)__(?!\w)", r"<strong>\1</strong>", text)
        text = re.sub(r"\*(?=\S)(.+?)(?<=\S)\*", r"<em>\1</em>", text)
        text = re.sub(r"(?<!\w)_(?=\S)(.+?)(?<=\S)_(?!\w)", r"<em>\1</em>", text)
        text = re.sub(r"~~(?=\S)(.+?)(?<=\S)~~", r"<del>\1</del>", text)
        return text

    # ---- blocks --------------------------------------------------------

    def render(self, text, cur_dir="."):
        self.cur_dir = cur_dir
        self.headings, self.slugs, self.refs = [], {}, {}
        lines = text.replace("\r\n", "\n").replace("\r", "\n").expandtabs(4).split("\n")
        if lines and lines[0].strip() == "---":
            for j in range(1, min(len(lines), 60)):
                if lines[j].strip() in ("---", "..."):
                    lines = lines[j + 1:]
                    break
        kept = []
        for line in lines:
            m = re.match(r"^ {0,3}\[([^\]]+)\]:\s*<?(\S+?)>?(?:\s+[\"'(](.*?)[\"')])?\s*$", line)
            if m:
                self.refs[m.group(1).strip().lower()] = (m.group(2), m.group(3))
            else:
                kept.append(line)
        return "\n".join(self.blocks(kept))

    def starts_block(self, line):
        return bool(FENCE_RE.match(line) or HEADING_RE.match(line) or HR_RE.match(line) or line.lstrip().startswith(">")
                    or self.html_block_start(line))

    @staticmethod
    def html_block_start(line):
        m = re.match(r"^ {0,3}</?([A-Za-z][A-Za-z0-9]*)(?:\s|/?>|$)", line)
        return bool(m and m.group(1).lower() in BLOCK_TAGS)

    def add_heading(self, level, raw):
        inner = self.inline(raw.strip())
        slug = base = slugify(inner)
        count = self.slugs.get(base, 0)
        self.slugs[base] = count + 1
        if count:
            slug = "%s-%d" % (base, count)
        self.headings.append((level, slug, re.sub(r"<[^>]+>", "", html.unescape(inner))))
        return '<h%d id="%s"><a class="anchor" href="#%s" aria-hidden="true">#</a>%s</h%d>' % (
            level, slug, slug, inner, level)

    def blocks(self, lines, tight=False):
        out, para = [], []
        i, n = 0, len(lines)

        def flush():
            if para:
                text = self.inline("\n".join(p.lstrip() for p in para).strip())
                out.append(text if tight else "<p>%s</p>" % text)
                para.clear()

        while i < n:
            line = lines[i]
            if not line.strip():
                flush()
                i += 1
                continue
            m = FENCE_RE.match(line)
            if m:
                flush()
                fence, lang, ind = m.group(2), m.group(3), len(m.group(1))
                body = []
                i += 1
                close_re = re.compile(r"^ {0,3}%s{%d,}\s*$" % (re.escape(fence[0]), len(fence)))
                while i < n and not close_re.match(lines[i]):
                    body.append(lines[i][min(ind, indent_of(lines[i])):])
                    i += 1
                i += 1
                out.append(self.code_block("\n".join(body), lang))
                continue
            if para:
                m = re.match(r"^ {0,3}(=+|-+)\s*$", line)
                if m:
                    level = 1 if m.group(1)[0] == "=" else 2
                    text = "\n".join(para)
                    para.clear()
                    out.append(self.add_heading(level, text))
                    i += 1
                    continue
            m = HEADING_RE.match(line)
            if m:
                flush()
                out.append(self.add_heading(len(m.group(1)), m.group(2) or ""))
                i += 1
                continue
            if HR_RE.match(line):
                flush()
                out.append("<hr>")
                i += 1
                continue
            if re.match(r"^ {0,3}>", line):
                flush()
                quote = []
                while i < n and re.match(r"^ {0,3}>", lines[i]):
                    quote.append(re.sub(r"^ {0,3}> ?", "", lines[i]))
                    i += 1
                out.append(self.quote(quote))
                continue
            if "|" in line and i + 1 < n and TABLE_DELIM_RE.match(lines[i + 1]) and "-" in lines[i + 1]:
                header = split_row(line)
                delim = split_row(lines[i + 1])
                if len(header) == len(delim):
                    flush()
                    rows = []
                    i += 2
                    while i < n and lines[i].strip() and "|" in lines[i]:
                        rows.append(split_row(lines[i]))
                        i += 1
                    out.append(self.table(header, delim, rows))
                    continue
            m = LIST_RE.match(line)
            if m and not (para and (m.group(3) == "" or (m.group(2)[0].isdigit() and not m.group(2).startswith("1")))):
                flush()
                html_list, i = self.parse_list(lines, i)
                out.append(html_list)
                continue
            if not para and self.html_block_start(line):
                chunk = []
                while i < n and lines[i].strip():
                    chunk.append(lines[i])
                    i += 1
                out.append(self.raw_html("\n".join(chunk)))
                continue
            if not para and line.startswith("    "):
                chunk = []
                while i < n and (lines[i].startswith("    ") or not lines[i].strip()):
                    chunk.append(lines[i][4:])
                    i += 1
                while chunk and not chunk[-1].strip():
                    chunk.pop()
                out.append(self.code_block("\n".join(chunk), ""))
                continue
            para.append(line)
            i += 1
        flush()
        return out

    def code_block(self, code, lang):
        label = html.escape(lang) if lang else "text"
        return ('<div class="code"><div class="code-head"><span class="lang">%s</span>'
                '<button class="copy" type="button">Copy</button></div><pre><code>%s</code></pre></div>'
                % (label, highlight(code, lang)))

    def quote(self, lines):
        m = re.match(r"^\[!(%s)\]\s*$" % "|".join(ALERTS), lines[0].strip()) if lines else None
        if m:
            inner = "\n".join(self.blocks(lines[1:]))
            return '<div class="alert alert-%s"><p class="alert-title">%s</p>%s</div>' % (
                m.group(1).lower(), ALERTS[m.group(1)], inner)
        return "<blockquote>%s</blockquote>" % "\n".join(self.blocks(lines))

    def table(self, header, delim, rows):
        aligns = []
        for d in delim:
            d = d.strip()
            aligns.append("center" if d.startswith(":") and d.endswith(":") else
                          "right" if d.endswith(":") else "left" if d.startswith(":") else "")

        def cell(tag, text, a):
            style = ' style="text-align:%s"' % a if a else ""
            return "<%s%s>%s</%s>" % (tag, style, self.inline(text), tag)

        out = ['<div class="table-wrap"><table><thead><tr>']
        out += [cell("th", c, aligns[k]) for k, c in enumerate(header)]
        out.append("</tr></thead><tbody>")
        for row in rows:
            row = (row + [""] * len(header))[:len(header)]
            out.append("<tr>" + "".join(cell("td", c, aligns[k]) for k, c in enumerate(row)) + "</tr>")
        out.append("</tbody></table></div>")
        return "".join(out)

    def parse_list(self, lines, i):
        n = len(lines)
        first = LIST_RE.match(lines[i])
        ordered = first.group(2)[0].isdigit()
        kind = first.group(2)[-1] if ordered else first.group(2)
        start = int(first.group(2)[:-1]) if ordered else 1
        items, loose, done = [], False, False
        while i < n and not done:
            m = LIST_RE.match(lines[i])
            if not m or (m.group(2)[0].isdigit()) != ordered or (m.group(2)[-1] if ordered else m.group(2)) != kind:
                break
            indent, marker, spaces = len(m.group(1)), m.group(2), len(m.group(3))
            if spaces == 0 or spaces > 4:
                content_indent = indent + len(marker) + 1
                first_line = lines[i][indent + len(marker):].strip() if spaces else ""
            else:
                content_indent = indent + len(marker) + spaces
                first_line = lines[i][content_indent:]
            item = [first_line]
            i += 1
            while i < n:
                cur = lines[i]
                if not cur.strip():
                    j = i
                    while j < n and not lines[j].strip():
                        j += 1
                    if j < n and indent_of(lines[j]) >= content_indent:
                        item.extend([""] * (j - i))
                        i = j
                        continue
                    sib = LIST_RE.match(lines[j]) if j < n else None
                    if sib and indent_of(lines[j]) < content_indent and (sib.group(2)[0].isdigit()) == ordered:
                        loose = True
                        i = j
                    else:
                        done = True
                        i = j if False else i
                    break
                if indent_of(cur) >= content_indent:
                    item.append(cur[content_indent:])
                    i += 1
                    continue
                if item and item[-1].strip() and not LIST_RE.match(cur) and not self.starts_block(cur):
                    item.append(cur.lstrip())
                    i += 1
                    continue
                break
            items.append(item)
        loose = loose or any("" in it[:-1] and any(x.strip() for x in it[it.index(""):]) for it in items if "" in it)
        tag = "ol" if ordered else "ul"
        attrs = ' start="%d"' % start if ordered and start != 1 else ""
        li = []
        for item in items:
            box = ""
            tm = re.match(r"^\[([ xX])\]\s+", item[0])
            if tm:
                box = '<input type="checkbox" disabled%s> ' % (" checked" if tm.group(1) in "xX" else "")
                item = [item[0][tm.end():]] + item[1:]
            inner = "\n".join(self.blocks(item, tight=not loose))
            li.append("<li%s>%s%s</li>" % (' class="task"' if tm else "", box, inner))
        return "<%s%s>\n%s\n</%s>" % (tag, attrs, "\n".join(li), tag), i


